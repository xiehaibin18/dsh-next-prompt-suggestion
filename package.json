{
	"name": "dsh-next-prompt-suggestion",
	"description": "Next-prompt suggestion for DeepSeek Harness: replays the session's last model request after a human turn and offers the predicted next user input as a composer suggestion pill",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/xiehaibin18/dsh-next-prompt-suggestion.git"
	},
	"main": "lib/index.js",
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-renderer"
			],
			"platform": "web"
		}
	},
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"files": [
		"lib/**/*.js"
	],
	"scripts": {
		"test": "node --test"
	},
	"dependencies": {
		"@deepseek-ai/schemastery": "3.18.2"
	}
}
